{
    "configurations": [
        {
            "name": "Debug test.wipple",
            "request": "launch",
            "type": "wipple",
            "program": "${workspaceFolder}/test.wipple",
            "wipple": {
                "args": ["--lib=foundation.bin"],
                "path": "${workspaceFolder}/target/debug/wipple"
            }
        },
        {
            "name": "Compile and run test.wipple",
            "type": "lldb",

            "request": "launch",
            "cargo": {
                "args": ["run", "--config", "profile.dev.opt-level=0"]
            },
            "args": ["run", "test.wipple", "--lib=foundation.bin", "--facts"],
            "env": {
                "WIPPLE_DEBUG": "1"
            }
        }
    ]
}
