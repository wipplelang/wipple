Build-Collection : collection (infer element) => trait (collection element -> collection)

-- Can't create [`collection`] from items that are [`element@type`].
--
-- Creating [`collection`] from these items isn't supported. Double-check that
-- you're providing the right kinds of items here.
default error instance (Build-Collection collection element)

Initial-Collection : collection (infer element) => trait collection
instance (Initial-Collection collection element) where (Build-Collection collection element) (Initial collection) (collection :: List element) : Initial

instance (Build-Collection (List element) element) : l element -> l . append element

instance (Build-Collection (Dictionary key value) (key; value)) where (Equal key) (Hash key) : d (key; value) -> d . insert-entry key value

instance (Build-Collection (Set element) element) where (Equal element) (Hash element) : s element -> s . insert element
