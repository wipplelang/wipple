[assume]
Initial-Collection : collection (infer element) => trait collection

instance (Initial-Collection (collection :: List element) element) : intrinsic "empty-list"

instance (Initial-Collection (collection :: Dictionary key value) (key; value)) : Initial

instance (Initial-Collection (collection :: Set element) element) : Initial

[assume]
Build-Collection : collection (infer element) => trait (collection element -> collection)

-- Can't create [`collection`] from items that are [`element@type`].
--
-- Creating [`collection`] from these items isn't supported. Double-check that
-- you're providing the right kinds of items here.
default error instance (Build-Collection collection element)

instance (Build-Collection (collection :: List element) element) : l element -> l . append element

instance (Build-Collection (collection :: Dictionary key value) (key; value)) where (Equal key) (Hash key) : d (key; value) -> d . insert-entry key value

instance (Build-Collection (collection :: Set element) element) where (Equal element) (Hash element) : s element -> s . insert element
